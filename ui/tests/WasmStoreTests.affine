module WasmStoreTests;

// SPDX-License-Identifier: MPL-2.0
/// Contract checks for every formerly dormant core export bound by WasmStore.

fn check = (condition: bool, message: string) =>
  if !condition {
    Js.Exn.raiseError(`WasmStore binding failed: ${message}`)
  }

fn expectOk = (result: result<string, string>, expected: string, label: string) =>
  switch result {
  | Ok(value) => check(value == expected, label)
  | Error(message) => Js.Exn.raiseError(`${label}: ${message}`)
  }

fn runAll = () => {
  fn empty = WasmStore.reset("Bindings")
  check(Js.Dict.keys(empty.notes)->Array.length == 0, "reset starts empty")
  check(WasmStore.name() == "Bindings", "name")
  check(WasmStore.isEmpty(), "is_empty")
  check(WasmStore.len() == 0, "len on empty notebook")

  WasmStore.setName("Renamed")
  check(WasmStore.name() == "Renamed", "set_name")

  fn alpha = WasmStore.createNote("Alpha")->Result.getExn
  fn beta = WasmStore.createNote("Beta")->Result.getExn
  check(WasmStore.len() == 2 && !WasmStore.isEmpty(), "len and is_empty after insert")

  switch WasmStore.getNote(alpha.id) {
  | Ok(Some(note)) => check(note.title == "Alpha", "get_note")
  | Ok(None) => Js.Exn.raiseError("get_note unexpectedly returned None")
  | Error(message) => Js.Exn.raiseError(`get_note: ${message}`)
  }

  WasmStore.setAttribute(alpha.id, "status", "\"todo\"")->Result.getExn->ignore
  switch WasmStore.getNote(alpha.id) {
  | Ok(Some(note)) =>
    switch Js.Dict.get(note.attributes, "status") {
    | Some(_) => ()
    | None => Js.Exn.raiseError("set_attribute did not persist the attribute")
    }
  | _ => Js.Exn.raiseError("could not read note after set_attribute")
  }

  WasmStore.link(alpha.id, beta.id)->Result.getExn->ignore
  switch WasmStore.backlinks(beta.id) {
  | Ok(ids) => check(ids->Array.includes(alpha.id), "backlinks")
  | Error(message) => Js.Exn.raiseError(`backlinks: ${message}`)
  }

  expectOk(WasmStore.lambdadeltaEval("(+ 1 2)"), "3", "lambdadeltaEval")
  expectOk(WasmStore.evalLambdadelta("(+ 2 3)"), "5", "evalLambdadelta")
  // LambdaDelta's printed representation preserves string delimiters.
  expectOk(WasmStore.evalFormula(alpha.id, "(:title self)"), "\"Alpha\"", "evalFormula")
}

